# ==============================================================================
# Pentagon Page Builder - Production Environment Configuration Template
# ==============================================================================
# Security Notice: NEVER commit actual production secrets to version control.
# Copy this file to `/var/www/pentagon/shared/.env` on the production server.

APP_NAME="Pentagon Page Builder"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://builder.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode driver
APP_MAINTENANCE_DRIVER=file

# Bcrypt work factor for password hashing
BCRYPT_ROUNDS=12

# Production logging: daily rotating files, error level
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# PostgreSQL Database Configuration
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=page_builder_prod
DB_USERNAME=pentagon_app
DB_PASSWORD=REPLACE_WITH_STRONG_SECRET_PASSWORD

# Session Management (Encrypted & Secure Cookies)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# Broadcasting & Cache
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USER
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASS
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@builder.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend compilation config
VITE_APP_NAME="${APP_NAME}"
